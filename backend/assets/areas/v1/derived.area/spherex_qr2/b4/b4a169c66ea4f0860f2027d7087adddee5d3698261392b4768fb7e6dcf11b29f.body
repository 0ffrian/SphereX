# - {name: y_px, unit: pix, datatype: float64, description: 'centroid, PNG convention of /frames'}
# - {name: wavelength_um, unit: um, datatype: float64, description: WCS-WAVE at the centroid}
# - {name: bandwidth_um, unit: um, datatype: float64, description: WCS-WAVE at the centroid}
