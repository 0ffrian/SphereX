# - {columns_not_applicable: 'exptime_s, ra_3sigma_arcsec, dec_3sigma_arcsec, flag_reasons, contamination, refusal'}
# - {ades: 'phase 2 (no SPHEREx MPC observatory code, Q-145)'}
# - {wording: 'an unexplained track is a lead for follow-up, not a discovery (A16.5)'}
# - method:
#     settings: {ambiguity_ratio: 0.5, annulus_in_px: 6.0, annulus_out_px: 9.0, aperture_px: 3.0, area_version: area-2, bg_box_px: 32,
#       bg_iters: 5, bg_min_frac: 0.5, bg_sigma: 3.0, centroid_box_px: 5, centroid_formula: 'first moment of D = I - B over the centroid
#         box at the peak, positive unmasked pixels only: x_c = sum x_i D_i / F, F = sum D_i; sigma_x^2 = sum (x_i - x_c)^2 V_i / F^2
#         (same for y); sigma_c = sqrt((sigma_x^2 + sigma_y^2) / 2). Noise only: no pixel-phase or PSF term', cone_maxrec: 500, cone_radius_deg: 0.001,
#       coverage_cell_arcsec: 30.0, coverage_erode_px: 10.0, coverage_rule: largest_4_connected_piece, cutout_rule: bbox_of_frame_in_box_plus_2_margin,
#       delta_min_au: 0.05, detect_formula: 'peak = unmasked pixel with I - B > k_detect * sqrt(VARIANCE) that is the maximum of its peak
#         box; B = bilinear mesh of sigma-clipped box means; greedy minimum separation by (-D, row, column), on the peaks and again on
#         the centroids', exposure_tol_s: 1.0, fixed_formula: 'a dot that is not star with a dot of another visit within r_match at the
#         same RA/Dec, where that visit''s coverage holds it', glitch_formula: 'a dot is kept when it has a counterpart within r_match
#         + rate_max * |dt| (px) in at least k_visit - 1 other frames of its visit, both detectors counting; r_match = max(r_match_min_px,
#         r_match_sigma * sigma_c) of the larger of the two dots; k_visit = min(k_visit_max, frames of the visit whose cutout holds the
#         dot at least coverage_erode_px inside its edge)', grid_step_deg: 0.25, hardware_flags: 'TRANSIENT,OVERFLOW,SUR_ERROR,PHANTOM,REFERENCE,NONFUNC,DICHROIC,MISSING_DATA,HOT,COLD,FULLSAMPLE,PHANMISS,NONLINEAR,PERSIST',
#       inputs: recorded_eros_fixture, k_detect: 5.0, k_visit_max: 3, known_formula: 'SkyBoT cone per visit (area half-diagonal + rate_max
#         * visit span / 2 + p_max), V <= v_lim; Horizons TLIST from 500@-163182 at every exposure time; a track matches when at least
#         known_min_frac of its dots lie within max(r_known_min_px, 3 sigma_c + ephemeris 3 sigma)', known_min_frac: 0.666667, linker: pairs,
#       margin_deg: 0.02, measure_method_sha: ee37fa9c0d73f8f12ea154cd080f882b8e140ac87074893034111359ffc14e5f, measure_version: measure-1,
#       min_motion_px: 1.0, min_sep_px: 3.0, overlap_eps_deg2: 1.0e-12, p_max_arcsec: 60.0, pair_formula: 'rate window rate_min = r_match_min_px
#         / dt_v to rate_max = min(rate_max_deg_day, (diagonal - 2 margin) / dt_v); v_in = v_AB - w u with w the SPHEREx velocity about
#         the geocentre projected on the sky at the area centre (Horizons VECTORS, one per visit); u >= 0 fitted by least squares; residual
#         = largest |v_in - v_AB + w u| perpendicular to w; pass when residual <= max(v_tol_min, v_tol_sigma * sigma_v) and u <= 1/delta_min;
#         track when mutual best and best <= ambiguity_ratio * next', pair_test: parallax, peak_box_px: 3, r_known_min_px: 3.0, r_match_min_px: 2.0,
#       r_match_sigma: 3.0, rate_max_deg_day: 1.2, rms_max_px: 1.0, stamp_half_px: 11, star_artefact_flags: 'BLOOM,HALO', star_cones: 'track:1,track:2',
#       star_formula: 'a tracklet is star when every dot lies within max(r_match, r_px) of the same Gaia DR3 or CatWISE2020 source of
#         the visit''s star list, propagated to the dot time (r_px: the A19.6 mask radius); a dot whose flags hold a star_artefact_flags
#         name is star too', tracklet_formula: 'per visit, greedy best-first over seed pairs within the glitch radius: the line through
#         the pair predicts each frame, the nearest unused dot within r_match joins; least-squares line x(t), y(t) on the area plane;
#         kept when rms <= rms_max_px and the dots span 2 or more times; best = most dots, then smallest rms, then the earliest dot; sigma_v
#         from the fit residuals', v_lim: 22.0, v_tol_min_deg_day: 0.1, v_tol_sigma: 3.0, visit_gap_h: 1.0}
