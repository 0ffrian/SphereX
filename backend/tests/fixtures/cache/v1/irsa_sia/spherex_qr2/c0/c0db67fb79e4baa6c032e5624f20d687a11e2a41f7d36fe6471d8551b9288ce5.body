        <VALUES type="actual">
          <OPTION value="cube"/>
          <OPTION value="image"/>
        </VALUES>
      </PARAM>
      <PARAM name="EXPTIME" datatype="double" arraysize="2" unit="sec" value="" xtype="interval">
        <DESCRIPTION>Specify exposure duration</DESCRIPTION>
      </PARAM>
