      <PARAM name="POL" datatype="char" arraysize="*" value="">
        <DESCRIPTION>Specify polarization states</DESCRIPTION>
      </PARAM>
      <PARAM name="POS" datatype="char" arraysize="*" value="" xtype="polygon">
        <DESCRIPTION>Specify polygon of interest</DESCRIPTION>
      </PARAM>
      <PARAM name="POS" datatype="char" arraysize="*" value="" xtype="range">
        <DESCRIPTION>Specify range of interest</DESCRIPTION>
      </PARAM>
      <PARAM name="POS" datatype="char" arraysize="*" value="" xtype="circle">
        <DESCRIPTION>Specify circle of interest</DESCRIPTION>
      </PARAM>
      <PARAM name="RESPONSEFORMAT" datatype="char" arraysize="*" value="">
        <DESCRIPTION>specify format of response</DESCRIPTION>
        <VALUES type="actual">
          <OPTION value="csv"/>
          <OPTION value="db"/>
          <OPTION value="fits"/>
          <OPTION value="hdf5"/>
          <OPTION value="html"/>
          <OPTION value="ipac_table"/>
          <OPTION value="json"/>
          <OPTION value="json5"/>
          <OPTION value="oracle"/>
          <OPTION value="postgres"/>
          <OPTION value="sqlite"/>
