          <OPTION value="xml"/>
        </VALUES>
      </PARAM>
      <PARAM name="SPATRES" datatype="double" arraysize="2" unit="arcsec" value="" xtype="interval">
        <DESCRIPTION>Specify position resolution</DESCRIPTION>
      </PARAM>
      <PARAM name="SPECRP" datatype="double" arraysize="2" value="" xtype="interval">
        <DESCRIPTION>Specify energy resolving power</DESCRIPTION>
      </PARAM>
      <PARAM name="TARGET" datatype="char" arraysize="*" value="">
