    },
    "band_depth_1um": {
      "$ref": "#/definitions/TVNumber"
    },
    "band_depth_2um": {
      "$ref": "#/definitions/TVNumber"
    },
    "band_depth_3um": {
      "$ref": "#/definitions/TVNumber"
    },
    "slope_075_25": {
      "$ref": "#/definitions/TVNumber"
    },
    "ch4_depth_33": {
      "$ref": "#/definitions/TVNumber"
    },
    "flux_45um": {
      "$ref": "#/definitions/TVNumber"
    },
    "teff_K": {
      "$ref": "#/definitions/TVNumber"
    },
    "teq_K": {
      "$ref": "#/definitions/TVNumber"
    },
    "mass_mearth": {
      "$ref": "#/definitions/TVNumber"
    },
    "orbit_au": {
      "$ref": "#/definitions/TVNumber"
    },
    "orbital_period_d": {
      "$ref": "#/definitions/TVNumber"
    },
    "host_teff_K": {
      "$ref": "#/definitions/TVNumber"
    },
    "host_radius_rsun": {
      "$ref": "#/definitions/TVNumber"
    },
    "host_mass_msun": {
      "$ref": "#/definitions/TVNumber"
    },
    "host_age_gyr": {
      "$ref": "#/definitions/TVNumber"
    },
    "component_teff_K": {
      "$ref": "#/definitions/TVPair"
    },
    "period_var_d": {
      "$ref": "#/definitions/TVNumber"
    },
    "lightcurve": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/LightcurvePoint"
      }
    },
    "phase_angle_deg": {
      "$ref": "#/definitions/TVNumber"
    },
    "sun_vector": {
      "$ref": "#/definitions/TVVec3"
    },
    "gas_Q": {
      "$ref": "#/definitions/GasQ"
    },
    "coma_radius_km": {
      "$ref": "#/definitions/TVNumber"
    },
    "nucleus_radius_km_max": {
