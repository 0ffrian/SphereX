  "definitions": {
    "Tag": {
      "title": "Tag",
      "description": "The five provenance tags (R3.1, D-02).",
      "type": "string",
      "enum": [
        "measured",
        "derived",
        "model_dependent",
        "inferred_from_analog",
        "artistic"
      ]
    },
    "Tier": {
      "title": "Tier",
      "description": "Fallback tier of the rung that answered: 1 measured, 2 derived, 3 model_dependent, 4 inferred_from_analog, 5 artistic (D-32). Always agrees with the tag.",
      "type": "integer",
      "enum": [
        1,
        2,
        3,
        4,
        5
      ]
    },
    "ObjectType": {
      "title": "ObjectType",
      "description": "R3.2 and D-04.",
      "type": "string",
      "enum": [
        "asteroid_shape",
        "asteroid_procedural",
        "comet",
        "brown_dwarf",
        "brown_dwarf_binary",
        "star_mira",
        "star_ttauri",
        "star",
        "candidate",
        "planet_rocky",
        "planet_water",
        "gas_giant",
        "nebula",
        "nova"
      ]
    },
    "Pair": {
      "title": "Pair",
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "Triple": {
      "title": "Triple",
      "description": "An RGB triple or a 3-vector.",
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "TVNumber": {
      "title": "TVNumber",
      "description": "Tagged value (R3.1) holding a number.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "tag",
        "source"
      ],
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "null = unknown, never a guess."
        },
        "err": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "$ref": "#/definitions/Pair"
            }
          ]
        },
        "tag": {
          "$ref": "#/definitions/Tag"
        },
        "source": {
          "type": "string"
        },
        "formula": {
          "type": "string",
          "description": "Required, non-blank, when tag is derived."
        },
        "assumption": {
          "type": "string",
          "description": "Required, non-blank, when tag is model_dependent."
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "tag"
            ],
            "properties": {
              "tag": {
                "const": "derived"
              }
            }
          },
          "then": {
            "required": [
              "formula"
            ],
            "properties": {
              "formula": {
                "type": "string",
                "pattern": "\\S"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "tag"
            ],
            "properties": {
              "tag": {
                "const": "model_dependent"
              }
            }
          },
          "then": {
            "required": [
              "assumption"
            ],
            "properties": {
              "assumption": {
                "type": "string",
                "pattern": "\\S"
              }
            }
          }
        }
      ]
    },
