    "LightcurvePoint": {
      "title": "LightcurvePoint",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "t_mjd",
        "flux",
        "sigma",
        "lambda_um",
        "flags"
      ],
      "properties": {
        "t_mjd": {
          "type": "number"
        },
        "flux": {
          "type": "number"
        },
        "sigma": {
          "type": "number"
        },
        "lambda_um": {
          "type": "number"
        },
        "flags": {
          "type": "number"
        }
      }
    },
    "GasQ": {
      "title": "GasQ",
      "description": "Gas production rates, molecules/s. Either one value per molecule (the R3.2 shape, valid for one epoch), or keyed by epoch ('2025-08', '2025-12'), each holding one value per molecule (the Q-42 proposal, read by the comet renderer, Q-260). An epoch with no measurement is left out, never guessed.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "co2": {
          "$ref": "#/definitions/TVNumber"
        },
        "h2o": {
          "$ref": "#/definitions/TVNumber"
        },
        "co": {
          "$ref": "#/definitions/TVNumber"
        },
        "2025-08": {
          "$ref": "#/definitions/GasQEpoch"
        },
        "2025-12": {
          "$ref": "#/definitions/GasQEpoch"
        }
