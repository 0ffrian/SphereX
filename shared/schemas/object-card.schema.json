    "TVTrack": {
      "title": "TVTrack",
      "description": "Tagged value (R3.1) holding a sampled path: rows of [JD TDB, x, y, z (au), vx, vy, vz (au/day)], heliocentric ICRF (Q-261).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "tag",
        "source"
      ],
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "array",
                "minItems": 7,
                "maxItems": 7,
                "items": {
                  "type": "number"
                }
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "null = unknown, never a guess."
