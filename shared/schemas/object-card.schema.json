                "pattern": "\\S"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "tag"
            ],
            "properties": {
              "tag": {
                "const": "model_dependent"
              }
            }
          },
          "then": {
            "required": [
              "assumption"
            ],
