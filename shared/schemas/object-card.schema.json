{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "object-card.schema.json",
  "title": "ObjectCard",
  "description": "What is known about one object (R3.2). Served by GET /v1/objects/{id}/card (D-16). Single source of the contract (D-18).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "type"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable id, e.g. sbdb:101955 (A5.1)."
    },
    "name": {
      "type": "string"
    },
    "type": {
      "$ref": "#/definitions/ObjectType"
    },
    "diameter_km": {
      "$ref": "#/definitions/TVNumber"
    },
    "radius_rjup": {
      "$ref": "#/definitions/TVNumber"
    },
    "radius_rsun": {
      "$ref": "#/definitions/TVNumber"
    },
    "shape_source": {
      "$ref": "#/definitions/TVString"
    },
    "rot_period_h": {
      "$ref": "#/definitions/TVNumber"
    },
    "lightcurve_amp_mag": {
      "$ref": "#/definitions/TVNumber"
    },
    "albedo": {
      "$ref": "#/definitions/TVNumber"
    },
    "gaia_rgb": {
      "$ref": "#/definitions/TVRgb"
    },
    "spherex_rgb": {
      "$ref": "#/definitions/TVRgb"
    },
    "spectral_class": {
