              }
            }
          }
        },
        {
          "if": {
            "required": [
              "tag"
            ],
            "properties": {
              "tag": {
                "const": "model_dependent"
              }
            }
          },
          "then": {
            "required": [
              "assumption"
            ],
            "properties": {
              "assumption": {
                "type": "string",
                "pattern": "\\S"
              }
            }
          }
        }
      ]
    },
    "TVRgb": {
      "title": "TVRgb",
      "description": "Tagged value (R3.1) holding an RGB triple.",
      "type": "object",
      "additionalProperties": false,
      "required": [
