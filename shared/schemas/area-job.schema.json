{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "area-job.schema.json",
  "title": "LiveAreaJob",
  "description": "GET /v1/areas/live/{area_id}, and POST /v1/areas/live with start=true or for a stored area (Q-462): the state of a live area job. Results of a done job are served by /v1/areas/{area_id}/... as for a prepared area.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "area_id",
    "state",
    "steps",
    "elapsed_s",
    "eta_s"
  ],
  "properties": {
    "area_id": {
      "$ref": "#/definitions/LiveJobAreaId"
    },
    "state": {
      "enum": [
        "queued",
        "running",
        "done",
        "failed"
      ]
    },
    "step": {
      "type": [
        "string",
        "null"
      ],
      "description": "Id of the running step; null when not running."
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/LiveJobStep"
      }
    },
    "elapsed_s": {
      "type": "integer",
      "minimum": 0
    },
    "eta_s": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "description": "Rough time left; null when done, failed or unknown."
    },
    "queue_position": {
      "type": "integer",
      "minimum": 1,
      "description": "1 = next; only while queued."
    },
    "error": {
      "$ref": "#/definitions/LiveJobError"
    }
  },
  "definitions": {
    "LiveJobAreaId": {
      "title": "LiveJobAreaId",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:_.-]*$",
      "maxLength": 200
    },
    "LiveJobStep": {
      "title": "LiveJobStep",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "state"
      ],
      "properties": {
        "id": {
          "enum": [
            "visits",
            "frames",
            "dots",
            "labels",
            "join",
            "known"
          ]
        },
        "label": {
          "type": "string"
        },
        "state": {
          "enum": [
            "done",
            "running",
            "todo"
          ]
        },
        "done": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "LiveJobError": {
      "title": "LiveJobError",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "detail"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z_]+(:[a-z0-9_]+)*$"
        },
        "detail": {
          "type": "string"
        }
      }
    }
  }
}
