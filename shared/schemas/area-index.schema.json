{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "area-index.schema.json",
  "title": "AreaIndex",
  "description": "GET /v1/areas (A17.8): the prepared areas. Also holds the definitions the other area schemas share.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "areas",
    "cached_at",
    "computed_at",
    "missing",
    "provenance"
  ],
  "properties": {
    "areas": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/AreaIndexEntry"
      }
    },
    "cached_at": {
      "anyOf": [
        {
          "$ref": "#/definitions/AreaUtcTime"
        },
        {
          "type": "null"
        }
      ]
    },
    "computed_at": {
      "anyOf": [
        {
          "$ref": "#/definitions/AreaUtcTime"
        },
        {
          "type": "null"
        }
      ]
    },
    "missing": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/AreaMissingCode"
      }
    },
    "provenance": {
      "$ref": "#/definitions/AreaIndexProvenance"
    }
  },
  "definitions": {
    "AreaUtcTime": {
      "title": "AreaUtcTime",
      "description": "ISO-8601 UTC with a trailing Z (A17.8).",
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,6})?Z$"
    },
    "AreaRa": {
      "title": "AreaRa",
      "type": "number",
      "minimum": 0,
      "exclusiveMaximum": 360
    },
    "AreaDec": {
      "title": "AreaDec",
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "AreaAngleDeg": {
      "title": "AreaAngleDeg",
      "description": "Position angle in degrees, east of north, in [0, 360).",
      "type": "number",
      "minimum": 0,
      "exclusiveMaximum": 360
    },
    "AreaRaDec": {
      "title": "AreaRaDec",
      "description": "One polygon vertex: [ra, dec] in degrees.",
      "type": "array",
      "items": [
        {
          "$ref": "#/definitions/AreaRa"
        },
        {
          "$ref": "#/definitions/AreaDec"
        }
      ],
      "minItems": 2,
      "maxItems": 2,
      "additionalItems": false
    },
    "AreaId": {
      "title": "AreaId",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:_.-]*$"
    },
    "AreaFrameId": {
      "title": "AreaFrameId",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "AreaDotId": {
      "title": "AreaDotId",
      "description": "<frame_id>:<n>, n from 1 by the rounded centroid row, then column (Q-208 (14)).",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*:[1-9][0-9]*$"
    },
    "AreaTrackId": {
      "title": "AreaTrackId",
      "type": "string",
      "pattern": "^T[1-9][0-9]*$"
    },
    "AreaVisit": {
      "title": "AreaVisit",
      "type": "integer",
      "minimum": 1
    },
    "AreaDetector": {
      "title": "AreaDetector",
      "type": "integer",
      "minimum": 1,
      "maximum": 6
    },
    "AreaExposure": {
      "title": "AreaExposure",
      "type": "integer",
      "minimum": 1
    },
    "AreaMissingCode": {
      "title": "AreaMissingCode",
      "description": "A refusal code of A17.8 (register: A4.12).",
      "type": "string",
      "pattern": "^(checks:not_run|checks:d4_not_run|checks:d5_not_run|rate_grid:visits|area:visits|frames:cone_maxrec:[1-9][0-9]*|no_footprint:[A-Za-z0-9][A-Za-z0-9_.-]*|cutout:[A-Za-z0-9][A-Za-z0-9_.-]*|stars:(gaia|wise):[1-9][0-9]*|skybot:[1-9][0-9]*|horizons:.+|stamp:[A-Za-z0-9][A-Za-z0-9_.-]*:[1-9][0-9]*)$"
    },
    "AreaTag": {
      "title": "AreaTag",
      "description": "The tags Area search uses (A16.5); never inferred_from_analog or artistic.",
      "type": "string",
      "enum": [
        "measured",
        "derived",
        "model_dependent"
      ]
    },
    "AreaProvenanceEntry": {
      "title": "AreaProvenanceEntry",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag"
      ],
      "properties": {
        "tag": {
          "$ref": "#/definitions/AreaTag"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "formula": {
          "type": "string",
          "description": "Required, non-blank, when tag is derived."
        },
        "assumption": {
          "type": "string",
          "description": "Required, non-blank, when tag is model_dependent."
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "tag"
            ],
            "properties": {
              "tag": {
                "const": "derived"
              }
            }
          },
          "then": {
            "required": [
              "formula"
            ],
            "properties": {
              "formula": {
                "type": "string",
                "pattern": "\\S"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "tag"
            ],
            "properties": {
              "tag": {
                "const": "model_dependent"
              }
            }
          },
          "then": {
            "required": [
              "assumption"
            ],
            "properties": {
              "assumption": {
                "type": "string",
                "pattern": "\\S"
              }
            }
          }
        }
      ]
    },
    "AreaDotLabel": {
      "title": "AreaDotLabel",
      "type": "string",
      "enum": [
        "glitch",
        "star",
        "fixed",
        "mover"
      ]
    },
    "AreaVerdict": {
      "title": "AreaVerdict",
      "type": "string",
      "enum": [
        "found_blind",
        "unexplained",
        "unchecked",
        "possible"
      ]
    },
    "AreaSedLabel": {
      "title": "AreaSedLabel",
      "type": "string",
      "enum": [
        "smooth",
        "rough",
        "too_few",
        "not_informative"
      ]
    },
    "AreaLinker": {
      "title": "AreaLinker",
      "type": "string",
      "enum": [
        "pairs",
        "rate_grid"
      ]
    },
    "AreaSettings": {
      "title": "AreaSettings",
      "description": "Named starting values of the run (A17 intro), as written into the reply.",
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "number"
          },
          {
            "type": "string"
          }
        ]
      }
    },
    "AreaBin": {
      "title": "AreaBin",
      "description": "A half-open bin [min, max); max null for the open top bin.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "number"
        },
        "max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "AreaChecksMethod": {
      "title": "AreaChecksMethod",
      "description": "Settings of the gated checks (A17.6).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seeds",
        "n_per_cell",
        "snr_bins",
        "rate_bins",
        "n_control_runs",
        "psf",
        "distance_model"
      ],
      "properties": {
        "seeds": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "n_per_cell": {
          "type": "integer",
          "minimum": 1
        },
        "snr_bins": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AreaBin"
          }
        },
        "rate_bins": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AreaBin"
          }
        },
        "n_control_runs": {
          "type": "integer",
          "minimum": 1
        },
        "psf": {
          "type": "string",
          "minLength": 1
        },
        "distance_model": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "AreaMethod": {
      "title": "AreaMethod",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "settings"
      ],
      "properties": {
        "settings": {
          "$ref": "#/definitions/AreaSettings"
        },
        "checks": {
          "$ref": "#/definitions/AreaChecksMethod"
        }
      }
    },
    "AreaSkybotAnswer": {
      "title": "AreaSkybotAnswer",
      "description": "When that visit's SkyBoT cone was answered; null when it failed (skybot:<visit> in missing).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visit",
        "fetched_at"
      ],
      "properties": {
        "visit": {
          "$ref": "#/definitions/AreaVisit"
        },
        "fetched_at": {
          "anyOf": [
            {
              "$ref": "#/definitions/AreaUtcTime"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "AreaError": {
      "title": "AreaError",
      "description": "Error body: 404 area_not_found, 404 dot_not_found, 503 stamp_unavailable (A17.8).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error",
        "detail"
      ],
      "properties": {
        "error": {
          "type": "string",
          "enum": [
            "area_not_found",
            "dot_not_found",
            "stamp_unavailable"
          ]
        },
        "detail": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "AreaIndexEntry": {
      "title": "AreaIndexEntry",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "area_id",
        "ra",
        "dec",
        "width_deg",
        "height_deg",
        "data_release",
        "n_frames",
        "n_visits",
        "computed_at",
        "cached_at"
      ],
      "properties": {
        "area_id": {
          "$ref": "#/definitions/AreaId"
        },
        "ra": {
          "$ref": "#/definitions/AreaRa"
        },
        "dec": {
          "$ref": "#/definitions/AreaDec"
        },
        "width_deg": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height_deg": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "data_release": {
          "type": "string",
          "minLength": 1
        },
        "n_frames": {
          "type": "integer",
          "minimum": 0
        },
        "n_visits": {
          "type": "integer",
          "minimum": 0
        },
        "computed_at": {
          "$ref": "#/definitions/AreaUtcTime"
        },
        "cached_at": {
          "$ref": "#/definitions/AreaUtcTime"
        }
      }
    },
    "AreaIndexProvenance": {
      "title": "AreaIndexProvenance",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "areas"
      ],
      "properties": {
        "areas": {
          "$ref": "#/definitions/AreaProvenanceEntry"
        }
      }
    }
  }
}
