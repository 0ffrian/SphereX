{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "render-params.schema.json",
  "title": "RenderParams",
  "description": "How to draw and feel one object (R3.4). Served by GET /v1/objects/{id}/render-params (D-16). Single source of the contract (D-18).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "generator_version",
    "seed",
    "scale_m",
    "layers",
    "lighting",
    "view_modes",
    "haptics",
    "alt_text",
    "missing"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "$ref": "object-card.schema.json#/definitions/ObjectType"
    },
    "generator_version": {
      "type": "string"
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "description": "Seed = hash of (object id + generator version) (R1, A5.1). The hash is not specified yet (Q-35)."
    },
    "scale_m": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "description": "Physical radius in metres. null when the size is unknown: the body is refused, never guessed (Q-33)."
    },
    "layers": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Layer"
      },
      "description": "Ordered, each with a tag."
    },
    "textures": {
      "$ref": "#/definitions/RenderTextures"
    },
    "lighting": {
      "$ref": "#/definitions/RenderLighting"
    },
    "view_modes": {
      "$ref": "#/definitions/ViewModes"
    },
    "haptics": {
      "$ref": "#/definitions/HapticProfile"
    },
    "dynamics": {
      "$ref": "#/definitions/Dynamics"
    },
    "alt_text": {
      "type": "string",
      "description": "R9."
    },
    "missing": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Layers refused for missing data, shown to the user."
    }
  },
  "definitions": {
    "Layer": {
      "title": "Layer",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "tag",
        "tier",
        "description",
        "requires"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "tag": {
          "$ref": "object-card.schema.json#/definitions/Tag"
        },
        "tier": {
          "$ref": "object-card.schema.json#/definitions/Tier"
        },
        "description": {
          "type": "string"
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "formula": {
          "type": "string",
          "description": "Required, non-blank, when tag is derived or model_dependent."
        },
        "assumed": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ]
          },
          "description": "Inputs that were not measured, keyed by card field or rule input name, with the value used. Required when tag is model_dependent."
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "tag"
            ],
            "properties": {
              "tag": {
                "const": "measured"
              }
            }
          },
          "then": {
            "properties": {
              "tier": {
                "const": 1
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "tag"
            ],
            "properties": {
              "tag": {
                "const": "derived"
              }
            }
          },
          "then": {
            "properties": {
              "tier": {
                "const": 2
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "tag"
            ],
            "properties": {
              "tag": {
                "const": "model_dependent"
              }
            }
          },
          "then": {
            "properties": {
              "tier": {
                "const": 3
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "tag"
            ],
            "properties": {
              "tag": {
                "const": "inferred_from_analog"
              }
            }
          },
          "then": {
            "properties": {
              "tier": {
                "const": 4
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "tag"
            ],
            "properties": {
              "tag": {
                "const": "artistic"
              }
            }
          },
          "then": {
            "properties": {
              "tier": {
                "const": 5
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "tag"
            ],
            "properties": {
              "tag": {
                "enum": [
                  "derived",
                  "model_dependent"
                ]
              }
            }
          },
          "then": {
            "required": [
              "formula"
            ],
            "properties": {
              "formula": {
                "type": "string",
                "pattern": "\\S"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "tag"
            ],
            "properties": {
              "tag": {
                "const": "model_dependent"
              }
            }
          },
          "then": {
            "required": [
              "assumed"
            ],
            "properties": {
              "assumed": {
                "type": "object",
                "minProperties": 1
              }
            }
          }
        }
      ]
    },
    "DynamicsValue": {
      "title": "DynamicsValue",
      "description": "One motion rate with its provenance and the tier of the rung that answered (D-32). A rate no rung can answer is omitted and listed in missing as dynamics:<key>.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "tag",
        "tier",
        "source"
      ],
      "properties": {
        "value": {
          "type": "number"
        },
        "tag": {
          "$ref": "object-card.schema.json#/definitions/Tag"
        },
        "tier": {
          "$ref": "object-card.schema.json#/definitions/Tier"
        },
        "source": {
          "type": "string"
        },
        "formula": {
          "type": "string",
          "description": "Required, non-blank, when tag is derived or model_dependent."
        },
        "assumed": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ]
          },
          "description": "Inputs that were not measured, keyed by card field or rule input name, with the value used. Required when tag is model_dependent."
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "tag"
            ],
            "properties": {
              "tag": {
                "const": "measured"
              }
            }
          },
          "then": {
            "properties": {
              "tier": {
                "const": 1
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "tag"
            ],
            "properties": {
              "tag": {
                "const": "derived"
              }
            }
          },
          "then": {
            "properties": {
              "tier": {
                "const": 2
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "tag"
            ],
            "properties": {
              "tag": {
                "const": "model_dependent"
              }
            }
          },
          "then": {
            "properties": {
              "tier": {
                "const": 3
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "tag"
            ],
            "properties": {
              "tag": {
                "const": "inferred_from_analog"
              }
            }
          },
          "then": {
            "properties": {
              "tier": {
                "const": 4
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "tag"
            ],
            "properties": {
              "tag": {
                "const": "artistic"
              }
            }
          },
          "then": {
            "properties": {
              "tier": {
                "const": 5
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "tag"
            ],
            "properties": {
              "tag": {
                "enum": [
                  "derived",
                  "model_dependent"
                ]
              }
            }
          },
          "then": {
            "required": [
              "formula"
            ],
            "properties": {
              "formula": {
                "type": "string",
                "pattern": "\\S"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "tag"
            ],
            "properties": {
              "tag": {
                "const": "model_dependent"
              }
            }
          },
          "then": {
            "required": [
              "assumed"
            ],
            "properties": {
              "assumed": {
                "type": "object",
                "minProperties": 1
              }
            }
          }
        }
      ]
    },
    "PositiveDynamicsValue": {
      "title": "PositiveDynamicsValue",
      "description": "A DynamicsValue whose value is above 0 (periods and lifetimes).",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/definitions/DynamicsValue"
        }
      ],
      "properties": {
        "value": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "NonNegativeDynamicsValue": {
      "title": "NonNegativeDynamicsValue",
      "description": "A DynamicsValue whose value is 0 or more (rates).",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/definitions/DynamicsValue"
        }
      ],
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "Dynamics": {
      "title": "Dynamics",
      "description": "Motion data (R3.4, D-32). Absent = no motion data. Rates: spin_period_h: Sidereal rotation period, hours. diff_rotation: k in Omega(phi) = Omega_eq (1 - k sin^2 phi). jet_speed_ms: Peak zonal wind speed, m/s. spot_lifetime_d: Star spot group lifetime, days. flare_rate_per_d: Flares per day above the drawn threshold. pulsation_period_d: Pulsation period, days.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "speedup"
      ],
      "properties": {
        "spin_period_h": {
          "$ref": "#/definitions/PositiveDynamicsValue"
        },
        "diff_rotation": {
          "$ref": "#/definitions/DynamicsValue"
        },
        "jet_speed_ms": {
          "$ref": "#/definitions/DynamicsValue"
        },
        "spot_lifetime_d": {
          "$ref": "#/definitions/PositiveDynamicsValue"
        },
        "flare_rate_per_d": {
          "$ref": "#/definitions/NonNegativeDynamicsValue"
        },
        "pulsation_period_d": {
          "$ref": "#/definitions/PositiveDynamicsValue"
        },
        "speedup": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "spin",
              "spots",
              "flares",
              "winds",
              "clouds",
              "pulsation"
            ]
          },
          "additionalProperties": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "description": "Time-lapse factor shown on screen for each animated process (D-34). {} when nothing moves."
        }
      }
    },
    "RenderTextures": {
      "title": "RenderTextures",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "albedo",
        "height",
        "normal"
      ],
      "properties": {
        "albedo": {
          "type": "string"
        },
        "height": {
          "type": "string"
        },
        "normal": {
          "type": "string"
        },
        "roughness": {
          "type": "string"
        },
        "height_bin": {
          "type": "string"
        },
        "relief_amp": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Peak relief as a fraction of the body radius (R6.2 relief_amp): the scale of the displacement by the baked height map (R7.2). Optional (Q-103); the backend sends it for `asteroid_procedural` (issue #62), tagged `artistic` through its `displacement` layer."
        }
      }
    },
    "RenderLighting": {
      "title": "RenderLighting",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "sun",
            "self"
          ]
        },
        "sun_dir": {
          "$ref": "object-card.schema.json#/definitions/Triple"
        },
        "phase_angle_deg": {
          "type": "number"
        }
      }
    },
    "ViewModes": {
      "title": "ViewModes",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visible"
      ],
      "properties": {
        "visible": {
          "$ref": "#/definitions/VisibleMode"
        },
        "spherex_ir": {
          "$ref": "#/definitions/VisibleMode"
        }
      }
    },
    "VisibleMode": {
      "title": "VisibleMode",
      "description": "D-23. IRMode uses the same shape. When a mode is not available, the reason goes in missing.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available",
        "badge",
        "rgb",
        "source"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "badge": {
          "type": "string"
        },
        "rgb": {
          "anyOf": [
            {
              "$ref": "object-card.schema.json#/definitions/TVRgb"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "type": "string",
          "enum": [
            "gaia_rgb",
            "class_palette",
            "spherex_rgb"
          ]
        },
        "channels_um": {
          "$ref": "object-card.schema.json#/definitions/Triple"
        }
      }
    },
    "TextureHaptic": {
      "title": "TextureHaptic",
      "description": "terrain = height plus ocean and ice masks; flow = bands, jets, storms (D-12).",
      "type": "string",
      "enum": [
        "height",
        "mesh",
        "bands",
        "terrain",
        "flow",
        "none"
      ]
    },
    "DataHaptic": {
      "title": "DataHaptic",
      "type": "string",
      "enum": [
        "field",
        "flux_pulse",
        "teq_pulse",
        "heartbeat",
        "dimming",
        "motion",
        "detections",
        "none"
      ]
    },
    "HapticProfile": {
      "title": "HapticProfile",
      "description": "R8.8.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "texture",
        "texture_tag",
        "data",
        "data_tag",
        "params"
      ],
      "properties": {
        "texture": {
          "$ref": "#/definitions/TextureHaptic"
        },
        "texture_tag": {
          "$ref": "object-card.schema.json#/definitions/Tag"
        },
        "data": {
          "$ref": "#/definitions/DataHaptic"
        },
        "data_tag": {
          "$ref": "object-card.schema.json#/definitions/Tag"
        },
        "params": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          },
          "description": "For example tau, k, softness, maxRateHz."
        }
      }
    }
  }
}
